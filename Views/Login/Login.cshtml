@model ECampus.Modele_de_vue_communes.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Connexion";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - e-Campus</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login">

        <!-- Panneau gauche : identité visuelle -->
        <section class="login__brand">
            <div class="brand">
                <span class="brand__logo">eC</span>
                <span class="brand__name">e-Campus</span>
            </div>
            <h1 class="login__tagline">Le suivi de vos activités académiques, en un seul endroit.</h1>
            <p class="login__subtitle">Cours, cahier de texte, présence et babillard.</p>
        </section>

        <!-- Panneau droit : formulaire -->
        <section class="login__panel">
            <form class="card" asp-controller="Login
            " asp-action="Login" method="post" novalidate>
                <header class="card__header">
                    <h2>Connexion</h2>
                    <p>Entrez vos identifiants pour accéder à votre espace.</p>
                </header>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="nom@exemple.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="field__error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <div class="field__password">
                        <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" id="togglePassword" class="field__toggle" aria-label="Afficher le mot de passe">
                            Afficher
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field__error"></span>
                </div>

                <div class="row">
                    <label class="check">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
                    </label>
                    <a href="#" class="link">Mot de passe oublié ?</a>
                </div>

                <button type="submit" class="btn">Se connecter</button>
            </form>

            <footer class="login__footer">© @DateTime.Now.Year e-Campus</footer>
        </section>
    </main>

    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>